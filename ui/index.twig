<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="{{ description }}"
    />
    <meta name="theme-color" content="#f5f6f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14181d" media="(prefers-color-scheme: dark)" />
    <title>{{ page_title }}</title>
    <link rel="stylesheet" href="./css/app.css" />
    <script src="./js/app.js" defer></script>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar" aria-label="Main navigation">
        <a class="brand" href="#dashboard" aria-label="Rsync Desktop dashboard">
          <span class="brand-mark" aria-hidden="true">r</span>
          <span class="brand-name">rsync<span>desktop</span></span>
        </a>

        <div class="workspace-label">WORKSPACE</div>
        <nav class="navigation">
          <a class="nav-link is-active" href="#dashboard" aria-current="page">
            <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="5.5" height="5.5" rx="1"/><rect x="11.5" y="3" width="5.5" height="5.5" rx="1"/><rect x="3" y="11.5" width="5.5" height="5.5" rx="1"/><rect x="11.5" y="11.5" width="5.5" height="5.5" rx="1"/></svg>
            Dashboard
          </a>
          <a class="nav-link" href="#connections">
            <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="4" width="14" height="12" rx="2"/><path d="M7 8h6M7 11h3M5.5 16v1.5M14.5 16v1.5"/></svg>
            Connection
            <span class="nav-count" id="profile-nav-count">0</span>
          </a>
          <a class="nav-link" href="#activity">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 3.5h8l4 4v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/><path d="M12 3.5v4h4M7 11h6M7 14h6"/></svg>
            Activity
          </a>
        </nav>

        <div class="sidebar-bottom">
          <div class="sidebar-note">
            <span class="note-icon" aria-hidden="true">i</span>
            <p>Every transfer starts with a preview. You stay in control.</p>
          </div>
          <div class="version-label">EARLY ACCESS <span>v0.1.0</span></div>
        </div>
      </aside>

      <main class="main-content">
        <header class="topbar">
          <div id="breadcrumb" class="breadcrumb">Workspace <span>/</span> Dashboard</div>
          <div class="topbar-status"><span class="status-dot"></span> Local app</div>
        </header>

        <div class="page-content view-content" data-view="dashboard">
          <section class="page-heading" aria-labelledby="page-title">
            <div>
              <p class="eyebrow">RSYNC OVER SSH</p>
              <h1 id="page-title">Good transfers start with a clear plan.</h1>
              <p class="page-subtitle">Set up a connection, choose what to sync, then review every change before it happens.</p>
            </div>
            <div class="heading-mark" aria-hidden="true">
              <svg viewBox="0 0 48 48"><path d="M11 16h25l-6-6M37 32H12l6 6M36 16l-6-6M12 32l6 6"/></svg>
            </div>
          </section>

          <div class="foundation-notice" id="dashboard-notice" role="status">
            <span class="notice-symbol" aria-hidden="true">✦</span>
            <p><strong>Preview before you sync.</strong> Review the planned changes first; live transfers require your confirmation.</p>
          </div>

          <div class="content-grid">
            <section class="panel transfer-panel" aria-labelledby="transfer-title">
              <div class="panel-heading">
                <div>
                  <p class="section-kicker">TRANSFER SETUP</p>
                  <h2 id="transfer-title">New sync</h2>
                </div>
                <span class="step-badge"><span>1</span> of 3</span>
              </div>

              <fieldset class="direction-fieldset">
                <legend>Transfer direction</legend>
                <div class="direction-switch" role="group" aria-label="Transfer direction">
                  <button class="direction-option is-selected" type="button" data-direction="push" aria-pressed="true">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5"/></svg>
                    Push to server
                  </button>
                  <button class="direction-option" type="button" data-direction="pull" aria-pressed="false">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10H4m5 5-5-5 5-5"/></svg>
                    Pull from server
                  </button>
                </div>
              </fieldset>

              <div class="field-group">
                <div class="field-label-row">
                  <label for="profile">Server profile</label>
                  <span class="field-hint">SSH connection</span>
                </div>
                <div class="select-wrap">
                  <select id="profile" name="profile" aria-describedby="profile-note" disabled>
                    <option value="" selected>No server profiles yet</option>
                  </select>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 8 4 4 4-4"/></svg>
                </div>
                <p id="profile-note" class="field-help">Choose a saved SSH connection.</p>
              </div>

              <div class="path-fields">
                <div class="field-group">
                  <div class="field-label-row" id="source-label-row">
                    <label id="source-label" for="source-path">Choose files to transfer</label>
                    <span class="path-kind" id="source-kind">LOCAL FILES</span>
                  </div>
                  <textarea id="source-path" rows="3" placeholder="/absolute/remote/file/or/folder&#10;~/another/remote/file" autocomplete="off" spellcheck="false" hidden></textarea>
                  <section class="folder-browser-panel" id="folder-browser-panel" aria-labelledby="source-label">
                    <div class="folder-browser-toolbar">
                      <button class="browse-button" id="browse-files-button" type="button" disabled>Select files</button>
                      <button class="browse-button" id="browse-folder-button" type="button" disabled>Choose folder</button>
                    </div>
                    <div class="folder-browser-toolbar">
                      <button class="browse-button" type="button" id="folder-browser-up" disabled>Up one level</button>
                      <button class="browse-button" type="button" id="add-current-folder" disabled>Add this folder</button>
                    </div>
                    <p class="folder-browser-path" id="folder-browser-path" aria-live="polite">Choose a folder to browse its contents.</p>
                    <p class="folder-browser-status" id="folder-browser-status" role="status"></p>
                    <div class="folder-browser-list" id="folder-browser-list" aria-label="Folder contents">
                      <p class="folder-browser-empty">Choose a folder to see its files and subfolders.</p>
                    </div>
                    <div class="folder-browser-actions">
                      <span id="folder-selection-count" class="folder-selection-count">0 selected</span>
                      <button class="button button-primary" type="button" id="add-folder-selection" disabled>Add selected</button>
                    </div>
                    <div class="selected-source-list" id="selected-source-list" aria-label="Selected transfer sources" hidden></div>
                  </section>
                  <p class="field-help" id="source-help" hidden>Enter one absolute remote path per line. Multiple remote files and folders are supported.</p>
                </div>
                <div class="flow-connector" aria-hidden="true"><span></span></div>
                <div class="field-group">
                  <div class="field-label-row">
                    <label id="destination-label" for="destination-path">Server destination folder</label>
                    <span class="path-kind path-kind-remote" id="destination-kind">REMOTE</span>
                  </div>
                  <div class="input-with-icon">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="14" height="6" rx="1.5"/><rect x="3" y="11" width="14" height="6" rx="1.5"/><path d="M6 6h.01M6 14h.01M9 6h5M9 14h5"/></svg>
                    <input id="destination-path" type="text" placeholder="/absolute/server/folder" autocomplete="off" spellcheck="false" />
                    <button class="browse-button" id="browse-destination-button" type="button" disabled aria-label="Browse destination folders">Browse</button>
                  </div>
                  <div class="remote-browser-panel" id="remote-browser-panel" hidden>
                    <div class="folder-browser-toolbar">
                      <button class="browse-button" type="button" id="remote-browser-up" disabled>Up one level</button>
                      <button class="browse-button" type="button" id="remote-browser-open">Open path</button>
                      <button class="browse-button" type="button" id="remote-browser-select" disabled>Select this folder</button>
                    </div>
                    <input class="folder-browser-path remote-browser-path-input" id="remote-browser-path-input" type="text" value="~/" aria-label="Remote folder path" />
                    <p class="folder-browser-status" id="remote-browser-status" role="status">Choose a server profile to browse remote folders.</p>
                    <div class="folder-browser-list" id="remote-browser-list" aria-label="Remote folder contents">
                      <p class="folder-browser-empty">Remote folder contents will appear here.</p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="options-row">
                <label class="dry-run-option">
                  <input id="dry-run" type="checkbox" checked disabled />
                  <span class="custom-checkbox" aria-hidden="true">
                    <svg viewBox="0 0 16 16"><path d="m3.5 8 3 3 6-6"/></svg>
                  </span>
                  <span class="dry-run-copy">
                    <strong>Preview changes first</strong>
                    <small>Dry run is always the first step</small>
                  </span>
                </label>
                <details class="exclusions">
                  <summary>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 5h12M6 10h8m-6 5h4"/></svg>
                    Exclusions
                    <span class="exclusion-count">0</span>
                  </summary>
                  <div class="exclusion-details exclusion-options">
                    <label><input type="checkbox" value=".git/" /> Version control (.git)</label>
                    <label><input type="checkbox" value="node_modules/" /> Dependencies (node_modules)</label>
                    <label><input type="checkbox" value="vendor/" /> Dependencies (vendor)</label>
                    <label><input type="checkbox" value=".env" /> Environment files (.env)</label>
                    <label><input type="checkbox" value="*.pem" /> Certificate files (*.pem)</label>
                    <label><input type="checkbox" value="*.key" /> Key files (*.key)</label>
                    <label><input type="checkbox" value=".DS_Store" /> macOS metadata (.DS_Store)</label>
                  </div>
                </details>
              </div>

              <div class="form-actions">
                <button class="button button-secondary" id="preview-button" type="button" disabled>Preview changes</button>
                <button class="button button-primary" id="start-sync-button" type="button" disabled>
                  Start sync
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5"/></svg>
                </button>
              </div>
              <p class="disabled-action-note" id="transfer-status" role="status">Choose a profile, source, and destination to preview.</p>
              <section class="watch-session-panel" id="watch-session-panel" aria-label="Watch and Sync status" hidden>
                <div>
                  <strong>Watch &amp; Sync</strong>
                  <p id="watch-session-status" role="status" data-state="idle"></p>
                </div>
                <button class="button button-secondary" id="stop-watch-button" type="button">Stop watching</button>
              </section>
              <p class="watch-mode-help">To watch a folder, select one local folder, preview it, then choose <strong>Watch &amp; Sync</strong>. Changes are pushed automatically; remote files are never deleted.</p>
              <pre class="transfer-output" id="transfer-output" aria-live="polite" hidden></pre>
            </section>

            <aside class="side-column">
              <section class="safety-card" aria-labelledby="safety-title">
                <div class="safety-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M12 3 4.5 6v5.5c0 4.8 3.2 8 7.5 9.5 4.3-1.5 7.5-4.7 7.5-9.5V6z"/><path d="m9 12 2 2 4-4"/></svg>
                </div>
                <div>
                  <h2 id="safety-title">Safety comes first</h2>
                  <p>Preview file changes before a live transfer. Replaced files can be backed up when that option is added.</p>
                </div>
              </section>
            </aside>
          </div>

          <section class="panel activity-panel" aria-labelledby="activity-title">
            <div class="panel-heading">
              <div>
                <p class="section-kicker">YOUR WORKSPACE</p>
                <h2 id="activity-title">Recent activity</h2>
              </div>
              <span class="activity-indicator"><span></span> Ready</span>
            </div>
            <div class="empty-activity">
              <div class="empty-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48"><path d="M9 13h30v24H9zM15 8h18v5M16 21h16M16 27h10M16 33h6"/></svg>
              </div>
              <h3>No transfers yet</h3>
              <p>Your transfer history and live progress will appear here.</p>
            </div>
          </section>

          <section class="workflow-strip" aria-label="Transfer workflow">
            <div class="workflow-title">
              <p class="section-kicker">THE WORKFLOW</p>
              <h2>Three steps. No surprises.</h2>
            </div>
            <ol>
              <li class="workflow-step is-current"><span class="workflow-number">01</span><span><strong>Connect</strong><small>Choose an SSH profile</small></span></li>
              <li class="workflow-line" aria-hidden="true"></li>
              <li class="workflow-step"><span class="workflow-number">02</span><span><strong>Preview</strong><small>Review planned changes</small></span></li>
              <li class="workflow-line" aria-hidden="true"></li>
              <li class="workflow-step"><span class="workflow-number">03</span><span><strong>Sync</strong><small>Run and track transfer</small></span></li>
            </ol>
          </section>

          <footer class="page-footer">
            <span>Rsync Desktop <span class="footer-divider">·</span> Built for careful transfers</span>
            <span>Nothing is transferred until you start a sync.</span>
          </footer>
        </div>

        <section class="page-content view-content" data-view="connections" aria-labelledby="connections-title" hidden>
          <div class="page-heading">
            <div>
              <p class="eyebrow">SSH PROFILES</p>
              <h1 id="connections-title">Your server connections.</h1>
              <p class="page-subtitle">Keep connection details organized and ready for your next transfer.</p>
            </div>
            <div class="heading-mark" aria-hidden="true">
              <svg viewBox="0 0 48 48"><rect x="8" y="10" width="32" height="13" rx="3"/><rect x="8" y="26" width="32" height="13" rx="3"/><path d="M14 16.5h.01M14 32.5h.01M19 16.5h14M19 32.5h14"/></svg>
            </div>
          </div>

          <div class="foundation-notice" role="status">
            <span class="notice-symbol" aria-hidden="true">✦</span>
            <p><strong>Profiles are stored on this device.</strong> Add SSH connection details and optionally choose a private-key file. Key contents are never imported or stored.</p>
          </div>

          <section class="panel connections-panel" aria-labelledby="profiles-title">
            <div class="panel-heading connections-panel-heading">
              <div>
                <p class="section-kicker">SAVED CONNECTIONS</p>
                <h2 id="profiles-title">Server profiles <span class="profile-total" id="profile-total">0</span></h2>
              </div>
              <button class="button button-primary" type="button" id="add-profile-button">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12"/></svg>
                Add profile
              </button>
            </div>

            <div class="connection-list" id="connection-list" aria-live="polite"></div>
            <div class="connection-empty" id="connection-empty">
              <div class="empty-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48"><rect x="9" y="9" width="30" height="13" rx="3"/><rect x="9" y="26" width="30" height="13" rx="3"/><path d="M15 15.5h.01M15 32.5h.01M21 15.5h11M21 32.5h11"/></svg>
              </div>
              <h3>No server profiles yet</h3>
              <p>Add a server profile to keep its SSH host, username, port, and private key location ready for your transfers.</p>
            </div>
            <p id="profile-message" class="profile-message" role="alert" hidden></p>
          </section>

          <dialog class="profile-dialog" id="profile-dialog" aria-labelledby="profile-dialog-title">
            <form id="profile-form" class="profile-form">
              <div class="profile-dialog-heading">
                <div>
                  <p class="section-kicker">SSH CONNECTION</p>
                  <h2 id="profile-dialog-title">Add server profile</h2>
                </div>
                <button class="dialog-close" type="button" data-close-dialog aria-label="Close dialog">×</button>
              </div>
              <input type="hidden" name="id" />
              <div class="profile-field">
                <label for="profile-name">Profile name</label>
                <input id="profile-name" name="name" type="text" maxlength="80" placeholder="Production server" required autocomplete="off" />
              </div>
              <div class="profile-form-row">
                <div class="profile-field">
                  <label for="profile-host">Host or SSH config alias</label>
                  <input id="profile-host" name="host" type="text" maxlength="253" placeholder="server.example.com" required autocomplete="off" />
                </div>
                <div class="profile-field port-field">
                  <label for="profile-port">SSH port</label>
                  <input id="profile-port" name="port" type="number" min="1" max="65535" value="22" required inputmode="numeric" />
                </div>
              </div>
              <div class="profile-field">
                <label for="profile-username">SSH username</label>
                <input id="profile-username" name="username" type="text" maxlength="128" placeholder="deploy" required autocomplete="username" />
              </div>
              <div class="profile-field">
                <label for="profile-key-path">Private key file <span>Optional</span></label>
                <div class="key-path-input">
                  <input id="profile-key-path" name="keyPath" type="text" placeholder="Uses your default SSH key if left empty" autocomplete="off" />
                  <button class="button button-secondary" id="browse-key-button" type="button">Browse</button>
                </div>
                <p class="field-help">Only the path is saved; the private key stays on your device.</p>
              </div>
              <div class="profile-dialog-heading git-profile-heading">
                <div>
                  <p class="section-kicker">GIT DEPLOYMENT</p>
                  <h2>Optional repository settings</h2>
                </div>
              </div>
              <div class="profile-field github-token-field">
                <label for="profile-github-token">GitHub personal access token (classic) <span>Optional</span></label>
                <input id="profile-github-token" name="githubToken" type="password" maxlength="512" placeholder="Enter a token to save or replace it" autocomplete="new-password" spellcheck="false" />
                <p class="field-help" id="github-token-status">Use a classic token with the repo scope for private repositories. Tokens are stored in the OS credential store and used only for local pushes to https://github.com.</p>
                <button class="profile-action profile-action-delete" id="remove-github-token-button" type="button" disabled>Remove saved token</button>
              </div>
              <div id="git-repository-list" class="git-repository-list"></div>
              <div class="git-repository-actions">
                <button class="button button-secondary" id="add-git-repository-button" type="button">Add repository</button>
              </div>
              <p class="field-help git-repository-help">Each repository can use its own local path, server checkout, and branch. Deploy pushes committed changes to origin, then fast-forwards the server checkout. The token is not sent to the server; server-side Git authentication must be configured separately.</p>
              <p id="profile-form-error" class="profile-form-error" role="alert" hidden></p>
              <div class="profile-form-actions">
                <button class="button button-secondary" type="button" data-close-dialog>Cancel</button>
                <button class="button button-primary" type="submit" id="save-profile-button">Save profile</button>
              </div>
            </form>
          </dialog>

          <div class="connection-guidance">
            <section class="panel guidance-card" aria-labelledby="profile-details-title">
              <span class="guidance-number" aria-hidden="true">01</span>
              <div>
                <h2 id="profile-details-title">Add your server details</h2>
                <p>Give each SSH destination a recognizable name and configure its host, port, and login.</p>
              </div>
            </section>
            <section class="panel guidance-card" aria-labelledby="ssh-key-title">
              <span class="guidance-number" aria-hidden="true">02</span>
              <div>
                <h2 id="ssh-key-title">Use an SSH key</h2>
                <p>Choose a private key already on your device. The app will use its file path, not ask you to paste key contents.</p>
              </div>
            </section>
            <section class="panel guidance-card" aria-labelledby="test-connection-title">
              <span class="guidance-number" aria-hidden="true">03</span>
              <div>
                <h2 id="test-connection-title">Verify before syncing</h2>
                <p>Connection testing will let you check SSH access before selecting folders or starting a transfer.</p>
              </div>
            </section>
          </div>
          <footer class="page-footer">
            <span>Rsync Desktop <span class="footer-divider">·</span> Built for careful transfers</span>
            <span>Private keys remain on your device.</span>
          </footer>
        </section>

        <section class="page-content view-content" data-view="activity" aria-labelledby="activity-page-title" hidden>
          <div class="page-heading">
            <div>
              <p class="eyebrow">TRANSFER HISTORY</p>
              <h1 id="activity-page-title">Every transfer, accounted for.</h1>
              <p class="page-subtitle">Review sync results and track active transfers from one place.</p>
            </div>
            <div class="heading-mark" aria-hidden="true">
              <svg viewBox="0 0 48 48"><path d="M10 9h19l9 9v21H10zM29 9v10h9M16 26h16M16 32h12"/><path d="M15 15h7"/></svg>
            </div>
          </div>

          <div class="activity-summary" aria-label="Transfer summary">
            <section class="panel activity-stat">
              <span class="activity-stat-icon total-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20"><path d="M4 3.5h8l4 4v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/><path d="M12 3.5v4h4M7 11h6M7 14h6"/></svg>
              </span>
              <span class="activity-stat-copy"><span>Total transfers</span><strong>0</strong></span>
            </section>
            <section class="panel activity-stat">
              <span class="activity-stat-icon complete-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20"><path d="M16.5 9.2v.8a6.5 6.5 0 1 1-3.9-6M16.5 4 10 10.5 7.5 8"/></svg>
              </span>
              <span class="activity-stat-copy"><span>Completed</span><strong>0</strong></span>
            </section>
            <section class="panel activity-stat">
              <span class="activity-stat-icon running-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="6.5"/><path d="M10 6v4l2.5 1.5"/></svg>
              </span>
              <span class="activity-stat-copy"><span>In progress</span><strong>0</strong></span>
            </section>
            <section class="panel activity-stat">
              <span class="activity-stat-icon failed-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="6.5"/><path d="m8 8 4 4m0-4-4 4"/></svg>
              </span>
              <span class="activity-stat-copy"><span>Needs attention</span><strong>0</strong></span>
            </section>
          </div>

          <section class="panel transfer-history" aria-labelledby="history-title">
            <div class="panel-heading history-heading">
              <div>
                <p class="section-kicker">ALL TRANSFERS</p>
                <h2 id="history-title">Activity history</h2>
              </div>
              <label class="filter-label" for="activity-filter">
                <span>Show</span>
                <select id="activity-filter" disabled>
                  <option>All activity</option>
                  <option>Completed</option>
                  <option>In progress</option>
                  <option>Needs attention</option>
                </select>
              </label>
            </div>
            <div class="history-table-wrap">
              <table class="history-table">
                <thead>
                  <tr><th scope="col">TRANSFER</th><th scope="col">SERVER</th><th scope="col">STATUS</th><th scope="col">WHEN</th><th scope="col">SIZE</th></tr>
                </thead>
              </table>
              <div class="history-empty">
                <div class="empty-icon" aria-hidden="true">
                  <svg viewBox="0 0 48 48"><path d="M9 13h30v24H9zM15 8h18v5M16 21h16M16 27h10M16 33h6"/></svg>
                </div>
                <h3>No transfer activity yet</h3>
                <p>Once transfers are available, you'll find previews, progress, and results here.</p>
                <a class="text-link" href="#dashboard">Go to dashboard <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </section>

          <footer class="page-footer">
            <span>Rsync Desktop <span class="footer-divider">·</span> Built for careful transfers</span>
            <span>History will be stored on this device.</span>
          </footer>
        </section>

        <dialog class="profile-dialog transfer-dialog" id="transfer-dialog" aria-labelledby="transfer-dialog-title">
          <div class="transfer-dialog-content">
            <div class="profile-dialog-heading">
              <div>
                <p class="section-kicker" id="transfer-dialog-kicker">DRY RUN</p>
                <h2 id="transfer-dialog-title">Review planned changes</h2>
              </div>
              <button class="dialog-close" type="button" id="close-transfer-dialog" aria-label="Close preview">×</button>
            </div>
            <p class="transfer-dialog-summary" id="transfer-dialog-summary"></p>
            <div class="transfer-output transfer-preview-output" id="preview-output" role="list" aria-label="Planned file changes"></div>
            <section class="file-compare-section" aria-labelledby="file-compare-title">
              <div class="file-compare-heading">
                <div>
                  <p class="section-kicker">FILE CONTENTS</p>
                  <h3 id="file-compare-title">Compare local and remote</h3>
                </div>
                <label class="diff-format-label" for="diff-format">
                  View
                  <select id="diff-format">
                    <option value="split">Side by side</option>
                    <option value="unified">Unified</option>
                  </select>
                </label>
              </div>
              <div class="file-compare-controls">
                <label class="file-compare-source-label" for="compare-source-select">File</label>
                <select id="compare-source-select" aria-label="File to compare"></select>
                <button class="button button-secondary" id="compare-file-button" type="button" disabled>Compare</button>
              </div>
              <p class="file-compare-help">Compare an individual text file with the same filename at the transfer destination.</p>
              <p class="file-compare-status" id="file-compare-status" role="status">Create a preview, then choose a file to compare.</p>
              <div class="file-diff-output" id="file-diff-output" aria-live="polite" hidden></div>
            </section>
            <p class="transfer-dialog-warning">A live sync can change files on the destination. Review the preview before continuing. Protected files (.env, production config, and common key/certificate formats) are excluded automatically; destination-only files are never deleted.</p>
            <div class="profile-form-actions">
              <button class="button button-secondary" type="button" id="cancel-transfer-button">Cancel</button>
              <button class="button button-secondary" type="button" id="start-watch-button" hidden>Sync &amp; Watch Folder</button>
              <button class="button button-primary" type="button" id="confirm-sync-button">Start live sync</button>
            </div>
          </div>
        </dialog>
      </main>
    </div>
  </body>
</html>
