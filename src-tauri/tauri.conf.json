{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rsync Desktop",
  "version": "0.1.0",
  "identifier": "com.nexifyup.rsync-desktop",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rsync Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "build": {
    "beforeDevCommand": "php scripts/build-frontend.php",
    "beforeBuildCommand": "php scripts/build-frontend.php",
    "frontendDist": "../ui/build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
